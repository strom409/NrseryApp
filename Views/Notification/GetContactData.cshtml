@model List<MVC_Project.Models.Notification.ContactPerson>
@{
    ViewData["Title"] = "Contact";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div class="toast show align-items-center text-white bg-success border-0 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">✅ @TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index:9999">
        <div class="toast show align-items-center text-white bg-danger border-0 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold">❌ @TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>Contact Persons</h4>
        <button class="btn btn-primary" onclick="openAddModal()">
            <i class="bi bi-plus-circle"></i> Add New
        </button>
    </div>

    <div class="row g-4">
        @foreach (var person in Model)
        {
            <div class="col-md-4">
                <div class="card shadow border-0 rounded-4 h-100">
                    <div class="text-center pt-4">
                        <img src="@person.Filepath"
                             class="rounded-circle"
                             style="width:100px;height:100px;object-fit:cover;border:3px solid #2563eb;"
                             onerror="this.src='https://via.placeholder.com/100'" />
                    </div>
                    <div class="card-body text-center">
                        <h5 class="fw-bold mb-1">@person.PersonalName</h5>
                        <p class="text-primary mb-2">@person.Designation</p>
                        <p class="mb-1">
                            <i class="bi bi-telephone-fill text-success"></i>
                            @person.PhoneNo
                        </p>
                        <p class="mb-0">
                            <i class="bi bi-envelope-fill text-danger"></i>
                            @person.Email
                        </p>
                        <button class="btn btn-sm btn-warning mt-3"
                                onclick="openEditModal(@person.Cid, '@person.PersonalName', '@person.Designation', '@person.PhoneNo', '@person.Email', '@person.Filepath')">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="contactModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Contact</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Notification" asp-action="AddOrUpdateContact" method="post">
                <input type="hidden" name="Cid" id="modalCid" value="0" />
                <input type="hidden" name="ActionType" id="modalActionType" value="1" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Name</label>
                        <input type="text" name="PersonalName" id="modalName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Designation</label>
                        <input type="text" name="Designation" id="modalDesignation" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Phone No</label>
                        <input type="text" name="PhoneNo" id="modalPhone" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" name="Email" id="modalEmail" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Photo</label>
                        <input type="file" id="photoInput" class="form-control" accept="image/*" onchange="previewPhoto(this)" />
                        <input type="hidden" name="Filepath" id="modalFilepath" />
                        <div class="text-center mt-2">
                            <img id="photoPreview" src="https://via.placeholder.com/80"
                                 class="rounded-circle mt-2"
                                 style="width:80px;height:80px;object-fit:cover;display:none;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var contactModal = new bootstrap.Modal(document.getElementById('contactModal'));

        function openAddModal() {
            document.getElementById('modalTitle').innerText = 'Add Contact';
            document.getElementById('modalCid').value = '0';
            document.getElementById('modalActionType').value = '1';
            document.getElementById('modalName').value = '';
            document.getElementById('modalDesignation').value = '';
            document.getElementById('modalPhone').value = '';
            document.getElementById('modalEmail').value = '';
            document.getElementById('modalFilepath').value = '';
            document.getElementById('photoPreview').style.display = 'none';
            contactModal.show();
        }

        function openEditModal(cid, name, designation, phone, email, filepath) {
            document.getElementById('modalTitle').innerText = 'Edit Contact';
            document.getElementById('modalCid').value = cid;
            document.getElementById('modalActionType').value = '2';
            document.getElementById('modalName').value = name;
            document.getElementById('modalDesignation').value = designation;
            document.getElementById('modalPhone').value = phone;
            document.getElementById('modalEmail').value = email;
            document.getElementById('modalFilepath').value = filepath;
            var preview = document.getElementById('photoPreview');
            if (filepath) {
                preview.src = filepath;
                preview.style.display = 'inline-block';
            } else {
                preview.style.display = 'none';
            }
            contactModal.show();
        }

        function previewPhoto(input) {
            const file = input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('photoPreview').src = e.target.result;
                document.getElementById('photoPreview').style.display = 'inline-block';
                document.getElementById('modalFilepath').value = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        setTimeout(() => document.querySelectorAll('.toast').forEach(t => t.classList.remove('show')), 4000);
    </script>
}
