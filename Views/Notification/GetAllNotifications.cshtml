    <div class="card shadow border-0 rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:14px;">
                <thead class="table-light text-center" style="background:#1e293b; color:white;">
                    <tr>
                        <th style="width: 8%;">S.No</th>
                        <th style="width: 22%;">Title</th>
                        <th style="width: 45%;">Description</th>
                        <th style="width: 10%;">Date</th>
                        <th style="width: 15%;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int sno = 1; }
                    @foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td class="fw-bold text-secondary">@(sno++)</td>
                            <td class="fw-semibold">@item.Title</td>
                            <td>
                                <span style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden; text-align: center;">
                                    @item.Description
                                </span>
                            </td>
                            <td class="text-muted fw-medium">
                                @(item.NotificationDate?.Length >= 10 ? item.NotificationDate.Substring(0, 10) : item.NotificationDate)
                            </td>
                            <td>
                                <div class="d-flex justify-content-center">
                                    <div class="d-flex gap-2" style="width: 180px; justify-content: flex-start;">
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-3 shadow-sm fw-semibold d-flex align-items-center justify-content-center" 
                                                style="width: 85px; border-width: 2px;"
                                                onclick="openEditModal(@item.NotificationId, '@Html.Raw(Uri.EscapeDataString(item.Title ?? ""))', '@Html.Raw(Uri.EscapeDataString(item.Description ?? ""))', '@Html.Raw(Uri.EscapeDataString(item.FilePath ?? ""))', '@Html.Raw(Uri.EscapeDataString(item.NotificationDate ?? ""))')">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                        @if (!string.IsNullOrEmpty(item.FilePath) && item.FilePath != "#")
                                        {
                                            <a href="@apiBaseUrl@item.FilePath" target="_blank" 
                                               class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-semibold d-flex align-items-center justify-content-center" 
                                               style="width: 85px; background: #2563eb; border-color: #2563eb;">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> View
                                            </a>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="notificationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Notification" asp-action="AddOrUpdateNotification" method="post">
                <input type="hidden" name="NotificationID" id="modalNotificationId" value="0" />
                <input type="hidden" name="ActionType" id="modalActionType" value="1" />
                <input type="hidden" name="NotificationDate" id="modalDate" value="" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Title</label>
                        <input type="text" name="Title" id="modalTitle2" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea name="Description" id="modalDescription" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="fw-semibold">File (PDF only)</label>
                        <input type="file" id="photoInput" class="form-control" accept=".pdf" onchange="previewPhoto(this)" />
                        <input type="hidden" name="Filepath" id="modalFilepath" />
                        <div id="pdfMessage" class="mt-2 small text-muted" style="display:none;">
                            <i class="bi bi-file-earmark-pdf text-danger"></i> PDF selected.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var notificationModal = new bootstrap.Modal(document.getElementById('notificationModal'));

        function openAddModal() {
            document.getElementById('modalTitle').innerText = 'Add Notification';
            document.getElementById('modalNotificationId').value = '0';
            document.getElementById('modalActionType').value = '1';
            document.getElementById('modalTitle2').value = '';
            document.getElementById('modalDescription').value = '';
            document.getElementById('modalFilepath').value = '';
            document.getElementById('modalDate').value = new Date().toISOString();
            document.getElementById('pdfMessage').style.display = 'none';
            document.getElementById('photoInput').value = '';
            notificationModal.show();
        }

        function openEditModal(id, title, description, filepath, date) {
            document.getElementById('modalTitle').innerText = 'Edit Notification';
            document.getElementById('modalNotificationId').value = id;
            document.getElementById('modalActionType').value = '2';
            document.getElementById('modalTitle2').value = decodeURIComponent(title);
            document.getElementById('modalDescription').value = decodeURIComponent(description);
            
            const decodedFilepath = decodeURIComponent(filepath);
            document.getElementById('modalFilepath').value = decodedFilepath;
            document.getElementById('modalDate').value = decodeURIComponent(date);
            
            var pdfMsg = document.getElementById('pdfMessage');
            if (decodedFilepath && decodedFilepath !== '#') {
                pdfMsg.style.display = 'block';
            } else {
                pdfMsg.style.display = 'none';
            }
            notificationModal.show();
        }

        function previewPhoto(input) {
            const file = input.files[0];
            if (!file) return;

            if (file.type !== "application/pdf") {
                toastr.error("Only PDF files are allowed.");
                input.value = "";
                document.getElementById('pdfMessage').style.display = 'none';
                return;
            }

            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('modalFilepath').value = e.target.result;
                document.getElementById('pdfMessage').style.display = 'block';
            };
            reader.readAsDataURL(file);
        }

        setTimeout(() => document.querySelectorAll('.toast').forEach(t => t.classList.remove('show')), 4000);
    </script>
}