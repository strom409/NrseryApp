@{
    ViewData["Title"] = "School Events / Calendar";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border-start border-4 border-primary">
        <div>
            <h3 class="mb-0 fw-bold text-primary"><i class="bi bi-calendar-event me-2"></i>School Events</h3>
            <p class="text-muted mb-0 small">View and manage school activities by date</p>
        </div>
        <button type="button" class="btn btn-primary d-flex align-items-center shadow-sm px-4 py-2 rounded-pill" onclick="addNewEvent()">
            <i class="bi bi-plus-circle-fill me-2"></i> Add New Event
        </button>
    </div>

    <!-- Filter Section -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom border-light">
            <h6 class="mb-0 fw-600 text-dark"><i class="bi bi-filter me-2 text-primary"></i>Filter by Date</h6>
        </div>
        <div class="card-body bg-light-50">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-600 small text-muted text-uppercase mb-2">Select Date</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar3 text-primary"></i></span>
                        <input type="date" id="eventDatePicker" class="form-control border-start-0 ps-0 shadow-none" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div id="eventContent" class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-check fs-1 d-block mb-3 opacity-25"></i>
                <p>Select a date to view events</p>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Event Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="eventModalLabel"><i class="bi bi-plus-circle me-2"></i>Add New Event</h5>
                <button type="button" class="btn btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="eventForm">
                    <input type="hidden" id="eventId" value="0">
                    <div class="mb-3">
                        <label class="form-label fw-600">Event Title</label>
                        <input type="text" id="eventTitle" class="form-control shadow-none border-light-dark" placeholder="Enter event title" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-600">Event Date</label>
                        <input type="date" id="modalEventDate" class="form-control shadow-none border-light-dark" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-600">Description</label>
                        <textarea id="eventDescription" class="form-control shadow-none border-light-dark" rows="4" placeholder="Enter event details" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light p-3 border-0">
                <button type="button" class="btn btn-secondary border-0 px-4 rounded-pill" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnSaveEvent" class="btn btn-primary border-0 px-4 rounded-pill shadow-sm">
                    <span id="saveBtnText">Save Event</span>
                    <span id="saveBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Load events for today by default
            var today = $('#eventDatePicker').val();
            if (today) {
                loadEvents(today);
            }

            // Date picker change event
            $('#eventDatePicker').on('change', function () {
                var selectedDate = $(this).val();
                if (selectedDate) {
                    loadEvents(selectedDate);
                }
            });

            // Save Event
            $('#btnSaveEvent').click(function () {
                var eventId = $('#eventId').val();
                var title = $('#eventTitle').val();
                var eventDate = $('#modalEventDate').val();
                var description = $('#eventDescription').val();
                var actionType = 1; // Always Add

                if (!title || !eventDate || !description) {
                    toastr.warning("Please fill all required fields.");
                    return;
                }

                toggleSaveLoading(true);

                var model = {
                    eventId: parseInt(eventId),
                    title: title,
                    eventDate: eventDate + "T00:00:00",
                    description: description,
                    actionType: actionType,
                    createdBy: "Admin"
                };

                $.ajax({
                    url: '@Url.Action("AddOrUpdateEvent", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function (response) {
                        if (response.isSuccess) {
                            toastr.success(response.message || "Event saved successfully.");
                            $('#eventModal').modal('hide');
                            
                            // Refresh list if date matches
                            var filterDate = $('#eventDatePicker').val();
                            if (filterDate === eventDate) {
                                loadEvents(filterDate);
                            }
                        } else {
                            toastr.error(response.message || "Error saving event.");
                        }
                    },
                    error: function () {
                        toastr.error("Server error. Please try again.");
                    },
                    complete: function () {
                        toggleSaveLoading(false);
                    }
                });
            });
        });

        function loadEvents(date) {
            $('#eventContent').html('<div class="card-body py-5 text-center"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading Events...</p></div>');
            
            $.ajax({
                url: '@Url.Action("GetEventData", "Home")',
                type: 'GET',
                data: { date: date },
                success: function (response) {
                    if (response.isSuccess && response.responseData && response.responseData.length > 0) {
                        var html = '<div class="table-responsive"><table class="table table-hover align-middle mb-0">';
                        html += '<thead class="bg-light text-primary fw-bold"><tr>';
                        html += '<th class="ps-4">S.No</th><th>Title</th><th>Description</th><th>Created By</th><th class="text-center pe-4">Action</th>';
                        html += '</tr></thead><tbody>';
                        
                        $.each(response.responseData, function (i, item) {
                            html += '<tr>';
                            html += '<td class="ps-4 text-muted">' + (i + 1) + '</td>';
                            html += '<td class="fw-bold">' + (item.title || 'No Title') + '</td>';
                            html += '<td class="text-muted small" style="max-width: 400px;">' + (item.description || '') + '</td>';
                            html += '<td><span class="badge bg-soft-primary text-primary rounded-pill px-3">' + (item.createdBy || 'Admin') + '</span></td>';
                            html += '<td class="text-center pe-4">';
                            html += '<button type="button" onclick=\'deleteEvent(' + JSON.stringify(item) + ')\' class="btn btn-sm btn-outline-danger rounded-circle" title="Delete Event"><i class="bi bi-trash"></i></button>';
                            html += '</td></tr>';
                        });
                        
                        html += '</tbody></table></div>';
                        $('#eventContent').html(html);
                    } else {
                        $('#eventContent').html('<div class="card-body py-5 text-center text-muted"><i class="bi bi-calendar-x fs-1 d-block mb-3 opacity-25"></i><p>' + (response.message || "No events found for this date.") + '</p></div>');
                    }
                },
                error: function () {
                    toastr.error("Error fetching event data.");
                    $('#eventContent').html('<div class="card-body py-5 text-center text-danger"><i class="bi bi-exclamation-triangle fs-1 d-block mb-3"></i><p>Error loading data.</p></div>');
                }
            });
        }

        function addNewEvent() {
            $('#eventId').val('0');
            $('#eventForm')[0].reset();
            
            // Set date to current picker date
            var filterDate = $('#eventDatePicker').val();
            $('#modalEventDate').val(filterDate);
            
            $('#eventModal').modal('show');
        }

        function deleteEvent(item) {
            if (confirm('Are you sure you want to delete this event: "' + item.title + '"?')) {
                var model = {
                    eventId: item.eventId,
                    eventDate: item.eventDate,
                    actionType: 2, // 2 for Delete
                    createdBy: item.createdBy || "Admin"
                };

                $.ajax({
                    url: '@Url.Action("AddOrUpdateEvent", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(model),
                    success: function (response) {
                        if (response.isSuccess) {
                            toastr.success(response.message || "Event deleted successfully.");
                            loadEvents($('#eventDatePicker').val());
                        } else {
                            toastr.error(response.message || "Error deleting event.");
                        }
                    },
                    error: function () {
                        toastr.error("Server error during deletion.");
                    }
                });
            }
        }

        function toggleSaveLoading(isLoading) {
            if (isLoading) {
                $('#btnSaveEvent').prop('disabled', true);
                $('#saveBtnText').addClass('d-none');
                $('#saveBtnSpinner').removeClass('d-none');
            } else {
                $('#btnSaveEvent').prop('disabled', false);
                $('#saveBtnText').removeClass('d-none');
                $('#saveBtnSpinner').addClass('d-none');
            }
        }
    </script>
    
    <style>
        .fw-600 { font-weight: 600; }
        .bg-light-50 { background-color: rgba(248, 249, 250, 0.5); }
        .bg-soft-primary { background-color: rgba(37, 99, 235, 0.1); }
        .border-light-dark { border-color: #e2e8f0; }
        .table-hover tbody tr:hover { background-color: rgba(37, 99, 235, 0.02); }
    </style>
}
