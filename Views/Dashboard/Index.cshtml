@{
    ViewData["Title"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>School Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f1f5f9;
        }

        .dashboard-header {
            font-weight: 700;
        }

        .card-box {
            border: none;
            border-radius: 15px;
            color: white;
            transition: 0.3s ease;
        }

            .card-box:hover {
                transform: translateY(-5px);
            }

        .bg-students {
            background: linear-gradient(135deg, #4f46e5, #6366f1);
        }

        .bg-teachers {
            background: linear-gradient(135deg, #16a34a, #22c55e);
        }

        .bg-classes {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
        }

        .bg-attendance {
            background: linear-gradient(135deg, #dc2626, #ef4444);
        }

        .icon-circle {
            font-size: 30px;
            opacity: 0.8;
        }

        .table thead {
            background-color: #1e293b;
            color: white;
        }

        .main-card {
            border-radius: 15px;
            border: none;
        }
    </style>
</head>
<body>

    <div class="container-fluid p-4">

        <h2 class="dashboard-header mb-4">
            🎓 School Dashboard Overview
        </h2>

        <!-- Top Cards -->
        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="card card-box bg-students p-4 shadow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6>Total Students</h6>
                            <h3>1,245</h3>
                        </div>
                        <div class="icon-circle">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-box bg-teachers p-4 shadow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6>Total Teachers</h6>
                            <h3>78</h3>
                        </div>
                        <div class="icon-circle">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-box bg-classes p-4 shadow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6>Total Classes</h6>
                            <h3>32</h3>
                        </div>
                        <div class="icon-circle">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card card-box bg-attendance p-4 shadow">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6>Attendance Today</h6>
                            <h3>92%</h3>
                        </div>
                        <div class="icon-circle">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Recent Students -->
        <div class="card main-card shadow mt-5 p-4">
            <h5 class="mb-3">Recent Admissions</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Class</th>
                            <th>Roll No</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Ayaan Khan</td>
                            <td>10th</td>
                            <td>101</td>
                            <td><span class="badge bg-success">Active</span></td>
                        </tr>
                        <tr>
                            <td>Fatima Ali</td>
                            <td>9th</td>
                            <td>102</td>
                            <td><span class="badge bg-primary">New</span></td>
                        </tr>
                        <tr>
                            <td>Omar Sheikh</td>
                            <td>8th</td>
                            <td>103</td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>