@model MVC_Project.Models.Auth.LoginRequest
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Admin Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(-45deg, #667eea, #764ba2, #6a11cb, #2575fc);
            background-size: 400% 400%;
            animation: gradientMove 10s ease infinite;
            overflow: hidden;
        }

        @@keyframes gradientMove {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* Floating circles */
        .circle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            animation: float 8s infinite ease-in-out;
        }

            .circle:nth-child(1) {
                width: 200px;
                height: 200px;
                top: 10%;
                left: 15%;
            }

            .circle:nth-child(2) {
                width: 150px;
                height: 150px;
                bottom: 15%;
                right: 10%;
                animation-delay: 2s;
            }

            .circle:nth-child(3) {
                width: 100px;
                height: 100px;
                top: 60%;
                left: 5%;
                animation-delay: 4s;
            }

        @@keyframes float {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-25px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        .login-card {
            position: relative;
            width: 100%;
            max-width: 420px;
            padding: 40px;
            border-radius: 20px;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(20px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            color: white;
            transition: 0.4s ease;
        }

            .login-card:hover {
                transform: translateY(-10px) scale(1.02);
                box-shadow: 0 30px 70px rgba(0,0,0,0.5);
            }

        h2 {
            text-align: center;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px;
            border: none;
            transition: 0.3s;
        }

            .form-control:focus {
                box-shadow: 0 0 15px rgba(255,255,255,0.8);
                transform: scale(1.02);
            }

        .btn-login {
            background: linear-gradient(45deg, #ff6a00, #ee0979);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            color: white;
            transition: 0.4s;
            position: relative;
            overflow: hidden;
        }

            .btn-login:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.4);
            }

            .btn-login::before {
                content: "";
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: rgba(255,255,255,0.2);
                transition: 0.5s;
            }

            .btn-login:hover::before {
                left: 100%;
            }

        .toggle-password {
            position: absolute;
            right: 15px;
            top: 38px;
            cursor: pointer;
            color: #555;
        }

        .input-wrapper {
            position: relative;
        }

        .brand {
            text-align: center;
            margin-bottom: 10px;
            font-size: 14px;
            opacity: 0.8;
        }

        @@media (max-width: 576px) {
            .login-card {
                padding: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="circle"></div>
    <div class="circle"></div>
    <div class="circle"></div>

    <div class="login-card">
        <h2>Admin Login</h2>
        <div class="brand">Secure Administration Panel</div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label>Username</label>
                <input asp-for="Username" class="form-control" placeholder="Enter username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3 input-wrapper">
                <label>Password</label>
                <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Enter password" />
                <span class="toggle-password" onclick="togglePassword()">👁</span>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-login">
                    Sign In
                </button>
            </div>

            <div class="text-danger mt-3 text-center">
                @Html.ValidationSummary()
            </div>
        </form>
    </div>

    <script>
        function togglePassword() {
            var pass = document.getElementById("password");
            pass.type = pass.type === "password" ? "text" : "password";
        }
    </script>

</body>
</html>