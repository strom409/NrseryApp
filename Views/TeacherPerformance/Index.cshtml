@model MVC_Project.Models.Performance.TeacherPerformanceViewModel
@{
    ViewData["Title"] = "Teacher Performance";
}

<div class="container-fluid">
    <div class="row page-titles mb-4">
        <div class="col-md-5 align-self-center">
            <h3 class="text-primary"><i class="bi bi-person-check-fill me-2"></i>Teacher Performance</h3>
        </div>
    </div>

    <!-- NOTIFICATIONS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-left: 5px solid #198754;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-left: 5px solid #ffc107;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-left: 5px solid #dc3545;">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="SavePerformance" method="post">
        @* Tag helper automatically handles Anti-Forgery token *@
        <input type="hidden" asp-for="SessionYear" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="card-header bg-dark text-white py-3 border-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Employee List (Session @Model.SessionYear)</h5>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold" style="border-radius: 8px;">
                        <i class="bi bi-save2 me-2"></i>Save Selected Records
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light text-uppercase fs-7 text-secondary">
                            <tr>
                                <th class="px-4" style="width: 60px;">
                                    <div class="form-check">
                                        <input type="checkbox" id="selectAll" class="form-check-input" />
                                    </div>
                                </th>
                                <th style="width: 120px;">Code</th>
                                <th>Employee</th>
                                <th>Father Name</th>
                                <th style="min-width: 300px;">Performance Rating</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Employees != null && Model.Employees.Any())
                            {
                                for (int i = 0; i < Model.Employees.Count; i++)
                                {
                                    <tr>
                                        <td class="px-4">
                                            <div class="form-check">
                                                <input type="checkbox" asp-for="@Model.Employees[i].IsSelected" class="form-check-input employee-check" />
                                            </div>
                                            <input type="hidden" asp-for="@Model.Employees[i].EmployeeID" />
                                            <input type="hidden" asp-for="@Model.Employees[i].EmployeeCode" />
                                            <input type="hidden" asp-for="@Model.Employees[i].EmployeeName" />
                                        </td>
                                        <td class="fw-bold text-dark">@Model.Employees[i].EmployeeCode</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="height: 35px; width: 35px; font-size: 0.8rem;">
                                                    @Model.Employees[i].EmployeeName.Substring(0, 1).ToUpper()
                                                </div>
                                                <span class="fw-semibold">@Model.Employees[i].EmployeeName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted">@Model.Employees[i].FatherName</td>
                                        <td>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-end-0 h-auto"><i class="bi bi-star-fill text-warning"></i></span>
                                                <textarea asp-for="@Model.Employees[i].EmployeePerformance" 
                                                       class="form-control border-start-0 ps-2" placeholder="e.g. Excellent / Good" 
                                                       style="background-color: #fcfcfc;" rows="2"></textarea>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <div class="py-4">
                                            <i class="bi bi-person-x fs-1 opacity-25 d-block mb-3"></i>
                                            <h5>No employees found</h5>
                                            <p class="small">Check the session settings in configuration.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .fs-7 { font-size: 0.75rem; letter-spacing: 0.5px; }
    .table-hover tbody tr:hover { background-color: #f8fafc; }
    .form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
    .input-group-text { border-radius: 8px 0 0 8px; }
    .form-control { border-radius: 0 8px 8px 0; }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Select All functionality
            $('#selectAll').change(function () {
                $('.employee-check').prop('checked', $(this).prop('checked'));
            });

            // If an individual checkbox is unchecked, uncheck "Select All"
            $('.employee-check').change(function () {
                if (!$(this).prop('checked')) {
                    $('#selectAll').prop('checked', false);
                }
                if ($('.employee-check:checked').length == $('.employee-check').length) {
                    $('#selectAll').prop('checked', true);
                }
            });
        });
    </script>
}
